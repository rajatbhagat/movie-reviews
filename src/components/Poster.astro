---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Omitted when the review has no `poster` in its frontmatter. */
  poster?: ImageMetadata;
  title: string;
  /** Display size. Both keep a 2:3 poster ratio and shrink on narrow screens. */
  size: 'card' | 'detail';
}

const { poster, title, size } = Astro.props;

// Rendered at twice the display width so the downscaled image stays sharp on
// retina screens. Display width itself lives in CSS, below.
const renderWidth = size === 'card' ? 184 : 360;

// Fallback tile: up to two initials from the title, so a review without a
// poster still reads as a distinct object in the list rather than a gap.
const initials = title
  .split(/\s+/)
  .map((word) => word[0])
  .filter((char): char is string => !!char && /[a-z0-9]/i.test(char))
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<div class:list={['poster', `size-${size}`]}>
  {
    poster ? (
      <Image src={poster} alt={`${title} poster`} width={renderWidth} loading="lazy" />
    ) : (
      <div class="fallback" aria-hidden="true">
        <span>{initials}</span>
      </div>
    )
  }
</div>

<style>
  .poster {
    flex-shrink: 0;
    width: var(--poster-width);
  }

  /* Prefixed because a bare `.card` would collide with the global .card
     class in global.css and give every thumbnail a border and padding. */
  .size-card {
    --poster-width: 92px;
  }

  .size-detail {
    --poster-width: 180px;
  }

  /* The 2:3 box is on the image itself, so posters that aren't exactly 2:3
     get cropped rather than changing the height of the row they sit in. */
  .poster :global(img),
  .fallback {
    width: 100%;
    /* `height: auto` is load-bearing: <Image> emits width/height attributes,
       which browsers apply as presentational hints, and aspect-ratio is
       ignored while both dimensions are explicit. Without this the poster
       renders at its full intrinsic height. */
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    background: var(--bg-soft);
  }

  .fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    background: linear-gradient(145deg, var(--bg-soft), var(--accent-soft));
  }

  .fallback span {
    font-weight: 700;
    font-size: calc(var(--poster-width) / 3.2);
    color: var(--accent);
    opacity: 0.75;
    letter-spacing: 0.02em;
  }

  /* Shrink rather than stack: on a phone the text matters more than the art,
     but dropping the thumbnail entirely loses the scannability it adds. */
  @media (max-width: 520px) {
    .size-card {
      --poster-width: 68px;
    }

    .size-detail {
      --poster-width: 132px;
    }
  }
</style>
