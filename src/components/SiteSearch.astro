---
import { url } from '../utils/url';

// Pagefind's runtime lives next to the index, both produced by
// `pagefind --site dist` after `astro build`. Neither exists under `astro dev`,
// so the widget reports itself unavailable there rather than failing silently.
const bundlePath = url('/pagefind/');
---

<div class="search" data-bundle-path={bundlePath}>
  <button
    type="button"
    class="search-toggle"
    aria-label="Search reviews"
    aria-expanded="false"
    aria-controls="search-panel"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
    </svg>
  </button>

  <div class="search-panel" id="search-panel">
    <div class="search-field">
      <svg
        class="search-field-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
      </svg>
      <input
        type="text"
        class="search-input"
        placeholder="Search reviews…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-label="Search reviews"
      />
      <kbd class="search-hint">esc</kbd>
    </div>
    <p class="search-status muted" role="status" aria-live="polite"></p>
    <div class="search-results" id="search-results" role="listbox" aria-label="Search results"></div>
  </div>

  <div class="search-backdrop"></div>
</div>

<noscript>
  <a href={url('/search/')} class="search-nojs">Search</a>
</noscript>

<script>
  // Kept at module scope so the WASM index is fetched and initialised once,
  // not again on every navigation or every time the panel is opened.
  let pagefind: Promise<any> | null = null;

  function loadPagefind(bundlePath: string) {
    if (!pagefind) {
      // @vite-ignore: this path is only real in the built site, so Vite must
      // not try to resolve it at build time.
      pagefind = import(/* @vite-ignore */ `${bundlePath}pagefind.js`).then(async (mod) => {
        await mod.init();
        return mod;
      });
    }
    return pagefind;
  }

  const MAX_RESULTS = 6;

  function initSearch() {
    const root = document.querySelector<HTMLElement>('.search');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const toggle = root.querySelector<HTMLButtonElement>('.search-toggle')!;
    const input = root.querySelector<HTMLInputElement>('.search-input')!;
    const status = root.querySelector<HTMLElement>('.search-status')!;
    const list = root.querySelector<HTMLElement>('.search-results')!;
    const backdrop = root.querySelector<HTMLElement>('.search-backdrop')!;
    const panel = root.querySelector<HTMLElement>('.search-panel')!;
    const bundlePath = root.dataset.bundlePath!;

    let active = -1;

    const options = () => [...list.querySelectorAll<HTMLAnchorElement>('.search-result')];

    function setActive(next: number) {
      const items = options();
      if (!items.length) return;
      // Wrap around, so holding ArrowDown cycles rather than dead-ending.
      active = (next + items.length) % items.length;
      items.forEach((el, i) => el.classList.toggle('is-active', i === active));
      const current = items[active];
      current.scrollIntoView({ block: 'nearest' });
      input.setAttribute('aria-activedescendant', current.id);
    }

    function setOpen(open: boolean) {
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      input.setAttribute('aria-expanded', String(open));
      if (open) {
        // The mobile drawer and the search panel both own the screen; opening
        // one closes the other.
        document.querySelector<HTMLButtonElement>('header.nav-open #nav-toggle')?.click();
        // An element that is still `visibility: hidden` silently refuses focus,
        // and the class was only just added. Reading a layout property forces
        // the style to apply now, which is deterministic where a rAF is not.
        void panel.offsetHeight;
        input.focus();
        loadPagefind(bundlePath).catch(() => {});
      } else {
        input.value = '';
        list.innerHTML = '';
        status.textContent = '';
        active = -1;
        input.removeAttribute('aria-activedescendant');
      }
    }

    function render(results: any[], query: string) {
      list.innerHTML = '';
      active = -1;
      input.removeAttribute('aria-activedescendant');

      if (!results.length) {
        status.textContent = `No reviews match “${query}”.`;
        return;
      }
      status.textContent = `${results.length} ${results.length === 1 ? 'review' : 'reviews'}`;

      results.forEach((result, i) => {
        const item = document.createElement('a');
        item.className = 'search-result';
        item.id = `search-result-${i}`;
        item.setAttribute('role', 'option');
        item.href = result.url;

        const title = document.createElement('span');
        title.className = 'search-result-title';
        title.textContent = result.meta?.title ?? result.url;

        const excerpt = document.createElement('p');
        excerpt.className = 'search-result-excerpt';
        // Pagefind's excerpt is HTML with <mark> around the hits. It is built
        // from this site's own content at build time, not from user input.
        excerpt.innerHTML = result.excerpt;

        item.append(title, excerpt);
        list.append(item);
      });
    }

    let seq = 0;
    async function run(query: string) {
      const mine = ++seq;
      if (!query.trim()) {
        list.innerHTML = '';
        status.textContent = '';
        return;
      }
      status.textContent = 'Searching…';
      try {
        const pf = await loadPagefind(bundlePath);
        const search = await pf.search(query);
        const results = await Promise.all(
          search.results.slice(0, MAX_RESULTS).map((r: any) => r.data())
        );
        // A slower earlier query must not overwrite a newer one's results.
        if (mine !== seq) return;
        render(results, query);
      } catch {
        if (mine !== seq) return;
        list.innerHTML = '';
        status.textContent = 'Search is unavailable — run a production build to generate the index.';
      }
    }

    let timer: number;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => run(input.value), 150);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter') {
        const current = options()[active];
        if (current) {
          e.preventDefault();
          current.click();
        }
      }
    });

    toggle.addEventListener('click', () => setOpen(!root.classList.contains('is-open')));
    backdrop.addEventListener('click', () => setOpen(false));
    root.querySelector('.search-hint')?.addEventListener('click', () => setOpen(false));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.stopPropagation();
        setOpen(false);
        toggle.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', initSearch);

  // Registered once, at module scope, so navigations don't stack handlers.
  document.addEventListener('keydown', (e) => {
    const root = document.querySelector<HTMLElement>('.search');
    if (!root || root.classList.contains('is-open')) return;
    const el = document.activeElement;
    const typing = el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement;
    // "/" is the convention on docs sites; Cmd/Ctrl-K is the other one people try.
    if ((e.key === '/' && !typing) || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey))) {
      e.preventDefault();
      root.querySelector<HTMLButtonElement>('.search-toggle')?.click();
    }
  });
</script>

<style>
  .search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-toggle {
    display: flex;
    align-items: center;
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem;
    cursor: pointer;
    color: var(--text-muted);
  }

  .search-toggle:hover,
  .search.is-open .search-toggle {
    color: var(--accent);
    border-color: var(--accent);
  }

  .search-panel {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(30rem, calc(100vw - 2.5rem));
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    padding: 0.75rem;
    z-index: 50;
    /* Collapsed by default. Animating the box rather than toggling `display`
       is what makes it read as the icon expanding into a field. */
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px) scaleY(0.96);
    transform-origin: top right;
    /* visibility is held until the fade-out finishes, but flipped instantly on
       open (below). Transitioning it symmetrically would leave the panel
       hidden for the first half of the animation, and a hidden input silently
       refuses focus. */
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
  }

  .search.is-open .search-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.45rem 0.6rem;
    background: var(--bg-soft);
  }

  .search-field:focus-within {
    border-color: var(--accent);
  }

  .search-field-icon {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.95rem;
    padding: 0;
  }

  .search-input:focus {
    outline: none;
  }

  .search-hint {
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0 0.3rem;
    font-size: 0.7rem;
    font-family: inherit;
    color: var(--text-muted);
    cursor: pointer;
    background: var(--bg);
  }

  .search-status {
    font-size: 0.78rem;
    margin: 0.6rem 0.2rem 0;
    min-height: 1rem;
  }

  .search-status:empty {
    display: none;
  }

  .search-results {
    max-height: min(60vh, 26rem);
    overflow-y: auto;
    margin-top: 0.35rem;
  }

  .search-results:empty {
    display: none;
  }

  /* Everything below the results container is built by JS, so it never carries
     Astro's scoping attribute and a plain scoped selector would not match it.
     .search-results is in the template and does carry the attribute, so it
     anchors the rules and the descendants are matched globally. */
  .search-results :global(.search-result) {
    display: block;
    padding: 0.55rem 0.6rem;
    border-radius: 8px;
    color: var(--text);
  }

  .search-results :global(.search-result:hover),
  .search-results :global(.search-result.is-active) {
    background: var(--bg-soft);
    text-decoration: none;
  }

  .search-results :global(.search-result-title) {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent);
  }

  .search-results :global(.search-result-excerpt) {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    /* Pagefind excerpts run long; two lines is enough to judge a hit. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Pagefind supplies the <mark> tags inside the excerpt HTML. Uses the site's
     own variables so the highlight follows the theme rather than staying the
     browser's fixed yellow. */
  .search-results :global(.search-result-excerpt mark) {
    background: var(--accent-soft);
    color: var(--text);
    border-radius: 3px;
    padding: 0 0.15em;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.16s ease, visibility 0s linear 0.16s;
    z-index: 45;
  }

  .search.is-open .search-backdrop {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.16s ease, visibility 0s;
  }

  .search-nojs {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }
</style>
