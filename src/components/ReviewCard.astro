---
import type { CollectionEntry } from 'astro:content';
import Rating from './Rating.astro';
import Poster from './Poster.astro';
import { slugify } from '../utils/slug';
import { url } from '../utils/url';

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const { title, year, director, rating, genres, poster } = review.data;
const href = url(`/reviews/${review.id}/`);
---

<article class="card">
  <a href={href} class="thumb" tabindex="-1" aria-hidden="true">
    <Poster poster={poster} title={title} size="card" />
  </a>

  <div class="body">
    <div class="top">
      <h3><a href={href}>{title}</a> <span class="muted year">({year})</span></h3>
      <Rating rating={rating} />
    </div>
    <p class="muted director">Directed by {director}</p>
    <p class="muted take">{review.data.description}</p>
    {
      genres.length > 0 && (
        <p class="genres">
          {genres.map((g) => (
            <a href={url(`/genres/${slugify(g)}/`)} class="pill">
              {g}
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  /* The thumbnail repeats the title link, so it's hidden from assistive tech
     and taken out of the tab order rather than read out twice. */
  .thumb {
    display: block;
    line-height: 0;
  }

  .body {
    min-width: 0;
    flex: 1;
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  h3 a {
    color: var(--text);
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .year {
    font-weight: 400;
    font-size: 0.95rem;
  }

  .director {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }

  .take {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
  }

  .genres {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0.85rem 0 0;
  }

  @media (max-width: 520px) {
    .card {
      gap: 1rem;
      padding: 1rem 1.1rem;
    }
  }
</style>
