---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rating from '../../components/Rating.astro';
import Poster from '../../components/Poster.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import site from '../../data/site.json';
import { slugify } from '../../utils/slug';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({ data }) => !data.draft);
  return reviews.map((review) => {
    const own = new Set(review.data.genres.map(slugify));
    // Only films that actually share a genre qualify. Topping the row up with
    // recent-but-unrelated reviews would make the heading a lie, so a review
    // with no overlap (or no genres at all) gets an empty list and the section
    // isn't rendered.
    const related = reviews
      .filter((other) => other.id !== review.id)
      .map((other) => ({
        other,
        overlap: other.data.genres.filter((genre) => own.has(slugify(genre))).length,
      }))
      .filter(({ overlap }) => overlap > 0)
      // Most genres in common first; recency breaks ties.
      .sort(
        (a, b) =>
          b.overlap - a.overlap ||
          b.other.data.watchedDate.valueOf() - a.other.data.watchedDate.valueOf()
      )
      .slice(0, 3)
      .map(({ other }) => other);

    return {
      params: { id: review.id },
      props: { review, related },
    };
  });
}

const { review, related } = Astro.props;
const { Content } = await render(review);
const { title, year, director, rating, genres, description, watchedDate, poster } = review.data;
const watchedStr = watchedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${title} (${year}) — ${site.title}`}
  description={description}
  type="article"
  image={poster}
  imageAlt={`${title} poster`}
>
  <article>
    <header>
      <Poster poster={poster} title={title} size="detail" />
      <div class="head-text">
        <h1>{title} <span class="muted year">({year})</span></h1>
        <p class="byline muted">Directed by {director}</p>
        <div class="rating-row">
          <Rating rating={rating} size="lg" />
          <span class="muted watched">Watched {watchedStr}</span>
        </div>
        <p class="muted description">{description}</p>
        {
          genres.length > 0 && (
            <p class="genres">
              {genres.map((g) => (
                <a href={url(`/genres/${slugify(g)}/`)} class="pill">
                  {g}
                </a>
              ))}
            </p>
          )
        }
      </div>
    </header>

    <div class="content">
      <Content />
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <h2>Related reviews</h2>
          <div class="review-list">
            {related.map((other) => (
              <ReviewCard review={other} />
            ))}
          </div>
        </section>
      )
    }

    <p><a href={url('/')}>← All reviews</a></p>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 44rem;
    margin: 2.5rem auto 0;
  }

  header {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .head-text {
    min-width: 0;
    flex: 1;
  }

  h1 {
    margin: 0 0 0.35rem;
    font-size: 2rem;
  }

  .year {
    font-weight: 400;
  }

  .byline {
    margin: 0;
    font-size: 0.95rem;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0.85rem 0;
  }

  .watched {
    font-size: 0.85rem;
  }

  .description {
    font-size: 1.05rem;
  }

  .genres {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .content {
    margin: 2rem 0;
  }

  .related {
    margin: 2.5rem 0 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .related h2 {
    font-size: 1.15rem;
    margin: 0 0 1rem;
  }

  .review-list {
    display: grid;
    gap: 1rem;
  }

  /* Stills and posters break out past the ~44rem reading column so their
     detail stays legible — centered, and capped to the viewport so they
     never cause horizontal scroll. */
  .content :global(img) {
    display: block;
    height: auto;
    max-width: min(56rem, 94vw);
    margin-left: 50%;
    transform: translateX(-50%);
    border-radius: 8px;
  }
</style>
