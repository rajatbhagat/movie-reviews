---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rating from '../../components/Rating.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import site from '../../data/site.json';
import { slugify } from '../../utils/slug';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({ data }) => !data.draft);
  return reviews.map((review) => {
    const own = new Set(review.data.genres.map(slugify));
    // Only films that actually share a genre qualify. Topping the row up with
    // recent-but-unrelated reviews would make the heading a lie, so a review
    // with no overlap (or no genres at all) gets an empty list and the section
    // isn't rendered.
    const related = reviews
      .filter((other) => other.id !== review.id)
      .map((other) => ({
        other,
        overlap: other.data.genres.filter((genre) => own.has(slugify(genre))).length,
      }))
      .filter(({ overlap }) => overlap > 0)
      // Most genres in common first; recency breaks ties.
      .sort(
        (a, b) =>
          b.overlap - a.overlap ||
          b.other.data.watchedDate.valueOf() - a.other.data.watchedDate.valueOf()
      )
      .slice(0, 3)
      .map(({ other }) => other);

    return {
      params: { id: review.id },
      props: { review, related },
    };
  });
}

const { review, related } = Astro.props;
const { Content } = await render(review);
const { title, year, director, rating, genres, description, watchedDate } = review.data;
const watchedStr = watchedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} (${year}) — ${site.title}`} description={description} type="article">
  {/* Marks this as the only indexable region on the site: once any page
      declares a Pagefind body, pages without one are skipped entirely, so
      /best/, /genres/ and /about/ stay out of the results. */}
  <article data-pagefind-body>
    <header>
      <h1>{title} <span class="muted year">({year})</span></h1>
      <p class="byline muted">Directed by {director}</p>
      <div class="rating-row">
        <Rating rating={rating} size="lg" />
        <span class="muted watched">Watched {watchedStr}</span>
      </div>
      <p class="muted description">{description}</p>
      {
        genres.length > 0 && (
          <p class="genres">
            {genres.map((g) => (
              <a href={url(`/genres/${slugify(g)}/`)} class="pill">
                {g}
              </a>
            ))}
          </p>
        )
      }
    </header>

    <div class="content">
      <Content />
    </div>

    {/* data-pagefind-ignore: these cards quote other films, so indexing them
        would make every review match its neighbours' titles. */}
    {
      related.length > 0 && (
        <section class="related" data-pagefind-ignore>
          <h2>Related reviews</h2>
          <div class="review-list">
            {related.map((other) => (
              <ReviewCard review={other} />
            ))}
          </div>
        </section>
      )
    }

    <p data-pagefind-ignore><a href={url('/')}>← All reviews</a></p>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 44rem;
    margin: 2.5rem auto 0;
  }

  h1 {
    margin: 0 0 0.35rem;
    font-size: 2rem;
  }

  .year {
    font-weight: 400;
  }

  .byline {
    margin: 0;
    font-size: 0.95rem;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0.85rem 0;
  }

  .watched {
    font-size: 0.85rem;
  }

  .description {
    font-size: 1.05rem;
  }

  .genres {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .content {
    margin: 2rem 0;
  }

  .related {
    margin: 2.5rem 0 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .related h2 {
    font-size: 1.15rem;
    margin: 0 0 1rem;
  }

  .review-list {
    display: grid;
    gap: 1rem;
  }
</style>
