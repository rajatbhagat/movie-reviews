---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { url } from '../utils/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  /** Social preview image. Review pages pass their poster; everything else
      falls back to the branded card in public/. */
  image?: ImageMetadata;
  /** Alt text for `image`. `title` is the full page title, which reads badly
      here, so callers pass the bare film title instead. */
  imageAlt?: string;
}

const {
  title,
  description = site.metaDescription,
  type = 'website',
  image,
  imageAlt,
} = Astro.props;
// Normalize the trailing slash so the canonical URL matches what the sitemap
// (and GitHub Pages, which redirects /path to /path/) actually serves.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pageUrl = new URL(path, Astro.site);

// og:image must be absolute — scrapers don't resolve relative paths. Both
// branches already carry the base path (`image.src` is an emitted asset URL,
// `url()` adds it), so `Astro.site` only supplies the origin.
const ogImage = new URL(image?.src ?? url('/og-default.png'), Astro.site);
// A poster is 2:3: a large card would crop it to a letterbox strip, so only
// the landscape fallback gets `summary_large_image`.
const twitterCard = image ? 'summary' : 'summary_large_image';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={url('/rss.xml')} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? site.title} />
    <meta property="og:site_name" content={site.title} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // Runs before paint (and re-runs after view-transition swaps) so the
      // chosen theme never flashes. localStorage overrides system preference.
      (function () {
        const apply = () => {
          const saved = localStorage.getItem('theme');
          const theme =
            saved === 'dark' || saved === 'light'
              ? saved
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
