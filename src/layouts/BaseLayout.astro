---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { url } from '../utils/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = site.metaDescription, type = 'website' } = Astro.props;
// Normalize the trailing slash so the canonical URL matches what the sitemap
// (and GitHub Pages, which redirects /path to /path/) actually serves.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pageUrl = new URL(path, Astro.site);

// Every page shares one social card: the site's own branded image, which is
// the only image the site ships. og:image must be absolute — scrapers don't
// resolve relative paths — and url() already supplies the base path, so
// Astro.site only adds the origin.
const ogImage = new URL(url('/og-default.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={url('/rss.xml')} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.title} />
    <meta property="og:site_name" content={site.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // Runs before paint (and re-runs after view-transition swaps) so the
      // chosen theme never flashes. localStorage overrides system preference.
      (function () {
        const apply = () => {
          const saved = localStorage.getItem('theme');
          const theme =
            saved === 'dark' || saved === 'light'
              ? saved
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
